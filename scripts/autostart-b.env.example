# Copy to autostart-b.env and edit. autostart-b.env is gitignored.
# Second isolated gardend stack (separate SQLite + ports).
# Prefer the same ADMIN_* as autostart.env so the desktop launcher can verify both.

JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Use-A-Long-Local-Admin-Password-123!
ADMIN_EMAIL=admin@localhost
LISTEN=127.0.0.1:50052
DATA_DIR=data-b
LOG_LEVEL=info
LOG_FORMAT=text
API_URL=http://127.0.0.1:50052
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3001
# When running both stacks, include both frontend ports so cross-stack redeem works.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
START_FRONTEND=1
# Optional label shown in launcher / logs.
INSTANCE_NAME=隔离实例
